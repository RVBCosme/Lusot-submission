# Keep LF in the repo and the working tree, so hooks, Lambda code and CI behave the same everywhere.
* text=auto eol=lf
# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.onnx binary
*.jar binary
*.wav binary
