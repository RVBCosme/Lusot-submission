# The portfolio demo build (`npm run build:demo -w app`, app/src/demo.ts, Nov 10, 2026). Vite reads this file only in
# `--mode demo`, and it wins over .env.local. The demo answers every call from the mock, so the API address is a
# placeholder that no request ever reaches. The privacy contact is the public repository's issues page, never an
# email address.
VITE_API_URL=https://api.lusot-demo.invalid
VITE_PRIVACY_CONTACT=https://github.com/RVBCosme/Lusot-submission/issues
