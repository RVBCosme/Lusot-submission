<?xml version="1.0" encoding="utf-8"?>
<!-- The FileProvider shares one folder of the app's own cache and nothing else: no external storage, and no root of
     any store (MS1 review, D-k). Lusot writes nothing here; see the provider's note in AndroidManifest.xml. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="shared" path="shared/" />
</paths>
