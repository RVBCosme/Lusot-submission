<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No cloud backup: the app keeps its few settings (the 18+ check and notice, the language, the theme, a random device
         id) on the phone, and Android doesn't copy them to a Google account. Some phones' direct transfer to a new phone
         may still copy them; nothing in them is private. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Kept, as D-k decided, and limited to one cache folder (res/xml/file_paths.xml). Capacitor's WebView client
             names this authority for an image input with `capture` (BridgeWebChromeClient.createImageFileUri); with or
             without the provider, that call fails safely and opens the file picker. Lusot has no file input (C602). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Geolocation Plugin -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Not required, so an app store wouldn't filter out a phone without GPS: network location still works, and the
         50 m rule refuses a poor fix anyway. (Android itself doesn't check uses-feature at install.) -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- In-app camera (C602): the page's own camera stream. With CAMERA declared, Capacitor's WebView client asks
         Android for it when the page opens the stream (BridgeWebChromeClient.onPermissionRequest). Not required,
         so an app store wouldn't filter out a device without a camera, where the app points to the samples. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
