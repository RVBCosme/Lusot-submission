# Copy to .env.local (git-ignored) and set the stack's ApiUrl output, with no trailing slash.
VITE_API_URL=https://example.execute-api.ap-southeast-1.amazonaws.com

# Development mock: with VITE_API_MOCK=1, `npm run dev` answers every API call from app/src/mock/ and sends no request
# at all. VITE_API_URL can then be any URL (the example above will do). A production build ignores it, and its bundle
# check fails if any of the mock got in. List the scenarios with scenarioNames() in app/src/mock/fixtures.ts.
# Choose one here, or per page with `?mock=<scenario>` on the URL (which wins). The default is level_knee.
# VITE_API_MOCK=1
# VITE_API_MOCK_SCENARIO=level_knee
