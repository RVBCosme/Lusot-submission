{
  "name": "@lusot/app",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/licences.mjs",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs dist",
    "build:e2e": "npm run prebuild && vite build --outDir .e2e-dist/none --emptyOutDir && node scripts/check-bundle.mjs .e2e-dist/none",
    "copy:review": "vitest run src/i18n/review.test.ts",
    "copy:table": "vitest run src/copy/table.test.ts",
    "e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.64.0",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
